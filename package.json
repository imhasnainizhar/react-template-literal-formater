{
  "name": "react-template-literal-formater",
  "displayName": "React Template Literal Formater",
  "version": "1.1.0",
  "description": "A vscode extension to format and organize React className props in one click, making clean up of Tailwind classes into dynamic template literals classes easier than ever before.",
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/imhasnainizhar/react-template-literal-formater.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "classNameTemplateLiteral.formatFile",
        "title": "Format className to {``}"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId =~ /^javascriptreact|typescriptreact|javascript|typescript$/",
          "command": "classNameTemplateLiteral.formatFile",
          "group": "1_modification"
        }
      ]
    }
  }
}
