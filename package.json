{
  "name": "react-template-literal-formatter",
  "displayName": "React Template Literal Formatter",
  "version": "2.0.0",
  "description": "A vscode extension to format and organize React className props in one click, making clean up of Tailwind classes into dynamic template literals classes easier than ever before.",
  "main": "./extension.js",
  "author": "Hasnain Izhar",
  "publisher": "TheHasnainIzhar",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/imhasnainizhar/react-template-literal-formatter.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "contributes": {
    "commands": [
      {
        "command": "classNameTemplateLiteral.formatFile",
        "title": "Format className as {`...`}",
        "category": "className"
      }
    ],
    "keybindings": [
      {
        "command": "classNameTemplateLiteral.formatFile",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && editorLangId =~ /^(javascript|typescript)(react)?$/"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "classNameTemplateLiteral.formatFile",
          "when": "editorTextFocus && editorLangId =~ /^(javascript|typescript)(react)?$/",
          "group": "1_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "className Template Literal",
      "properties": {
        "classNameTemplateLiteral.wrapWidth": {
          "type": "number",
          "default": 80,
          "minimum": 30,
          "description": "Maximum line width before a className is split across multiple lines."
        },
        "classNameTemplateLiteral.alwaysMultiline": {
          "type": "boolean",
          "default": false,
          "description": "Always format classNames as multi-line template literals, even short ones."
        },
        "classNameTemplateLiteral.convertOnType": {
          "type": "boolean",
          "default": true,
          "description": "Automatically convert className=\"...\" to className={`...`} while typing."
        }
      }
    }
  }
}